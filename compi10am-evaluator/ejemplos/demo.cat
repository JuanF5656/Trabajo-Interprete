let suma = function(a, b) {
    return a + b;
};

let total = 0;
for (let i = 1; i <= 5; i = i + 1) {
    total = suma(total, i);
}

let numeros = [2, 4, 6];
let datos = {"nombre": "gato", "activo": true};

if (datos["activo"] && total > 10) {
    total = total + numeros[0];
} else {
    total = 0;
}

let hackerman = function(m, n) {
    if (m == 0) { return n + 1; }
    if (n == 0) { return hackerman(m - 1, 1); }
    return hackerman(m - 1, hackerman(m, n - 1));
};

let fibonacci = function(n) {
    if (n <= 1) { return n; }
    return fibonacci(n - 1) + fibonacci(n - 2);
};

[total, hackerman(2, 2), fibonacci(10)];
